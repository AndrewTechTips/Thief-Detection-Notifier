# ─────────────────────────────────────────────────────────────
# IoT Vision Hub configuration
# Copy to `.env` and adjust. Real environment variables take precedence over this file.
# Nested groups use a double underscore: VISION_HUB_<GROUP>__<FIELD>
# List values accept comma-separated strings: a.com,b.com
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
VISION_HUB_APP__NAME="IoT Vision Hub"
# dev | test | prod  (prod enforces the safety checks marked [prod] below)
VISION_HUB_APP__ENV=dev
VISION_HUB_APP__DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
VISION_HUB_APP__LOG_LEVEL=INFO
# auto | console | json  (auto = json in prod, colored console otherwise)
VISION_HUB_APP__LOG_FORMAT=auto
VISION_HUB_APP__HOST=127.0.0.1
VISION_HUB_APP__PORT=8000
# Swagger UI, ReDoc and /openapi.json. Unset = enabled everywhere except prod.
# VISION_HUB_APP__DOCS_ENABLED=true
# Per-check timeout for GET /api/v1/health/ready
VISION_HUB_APP__HEALTH_CHECK_TIMEOUT_SECONDS=2

# ── Security ─────────────────────────────────────────────────
# [prod] Required. At least 32 chars (48 for HS384, 64 for HS512). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In dev a random secret is generated per process (tokens reset on restart).
# VISION_HUB_SECURITY__JWT_SECRET=
VISION_HUB_SECURITY__JWT_ALGORITHM=HS256
VISION_HUB_SECURITY__JWT_ISSUER=vision-hub
VISION_HUB_SECURITY__JWT_AUDIENCE=vision-hub-api
VISION_HUB_SECURITY__ACCESS_TOKEN_TTL_MINUTES=15
VISION_HUB_SECURITY__REFRESH_TOKEN_TTL_DAYS=7
VISION_HUB_SECURITY__ADMIN_USERNAME=admin
# [prod] Required. Argon2 hash of the admin password, never the plain password.
# Generate with: uv run vision-hub hash-password
# Single-quote it so `$` is not expanded.
# VISION_HUB_SECURITY__ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
# Browser origins allowed to call the API (the Phase 4 dashboard). [prod] Must not contain "*"
VISION_HUB_SECURITY__CORS_ORIGINS=http://localhost:5173
# Host headers the API answers to (others get 400). Add your LAN IP/hostname or public domain.
# [prod] Must not contain "*"
VISION_HUB_SECURITY__ALLOWED_HOSTS=localhost,127.0.0.1
# Per client IP, applied to login and token refresh. e.g. 5/minute, 20/hour
VISION_HUB_SECURITY__AUTH_RATE_LIMIT=5/minute

# ── SMTP (email alerts) ──────────────────────────────────────
VISION_HUB_SMTP__ENABLED=false
VISION_HUB_SMTP__HOST=smtp.gmail.com
VISION_HUB_SMTP__PORT=587
# starttls (port 587) | implicit (port 465) | none (local testing only; rejected in prod)
VISION_HUB_SMTP__TLS=starttls
VISION_HUB_SMTP__TIMEOUT_SECONDS=10
# Name announced in EHLO (defaults to this machine's hostname)
# VISION_HUB_SMTP__LOCAL_HOSTNAME=hub.example.com
# Optional (local relays may need none); for Gmail use an App Password.
# Without a username, SENDER is required.
# VISION_HUB_SMTP__USERNAME=you@gmail.com
# VISION_HUB_SMTP__PASSWORD=
# Defaults to USERNAME
# VISION_HUB_SMTP__SENDER=you@gmail.com
# Defaults to SENDER
# VISION_HUB_SMTP__RECIPIENTS=you@gmail.com,partner@example.com

# ── Database (PostgreSQL) ────────────────────────────────────
VISION_HUB_DB__HOST=localhost
VISION_HUB_DB__PORT=5432
VISION_HUB_DB__USER=vision_hub
# [prod] Must be set explicitly (the dev default is not accepted)
# VISION_HUB_DB__PASSWORD=
VISION_HUB_DB__NAME=vision_hub
VISION_HUB_DB__POOL_SIZE=5
VISION_HUB_DB__ECHO=false

# ── Storage ──────────────────────────────────────────────────
VISION_HUB_STORAGE__SNAPSHOTS_DIR=data/snapshots
VISION_HUB_STORAGE__JPEG_QUALITY=85
VISION_HUB_STORAGE__RETENTION_DAYS=30

# ── Vision (defaults; devices can override) ──────────────────
# Cameras to run, as TOML (see devices.example.toml). Unset = no cameras.
# VISION_HUB_VISION__DEVICES_FILE=devices.toml
# Held while running so a second process cannot open the same cameras
VISION_HUB_VISION__LOCK_FILE=data/vision-hub.lock
# Frames analysed per second per camera (extra frames from the camera are skipped)
VISION_HUB_VISION__TARGET_FPS=10
# Smallest moving region that counts, as a fraction of the frame (0.01 = 1 %).
# Lower = more sensitive (e.g. 0.003 when the camera is far away)
VISION_HUB_VISION__MIN_MOTION_AREA=0.01
# Must be odd
VISION_HUB_VISION__BLUR_KERNEL_SIZE=21
VISION_HUB_VISION__THRESHOLD=60
# Seconds without motion before an event is considered finished
VISION_HUB_VISION__MOTION_END_GRACE_SECONDS=2
# Minimum seconds between alerts for the same device
VISION_HUB_VISION__ALERT_COOLDOWN_SECONDS=60
VISION_HUB_VISION__STREAM_JPEG_QUALITY=70
# Live-view frames are downscaled to at most this width
VISION_HUB_VISION__STREAM_MAX_WIDTH=960
