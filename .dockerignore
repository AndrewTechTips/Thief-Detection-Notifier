# Only pyproject.toml, uv.lock, README.md and src/ are needed to build the image.

# Secrets and local state: never send them to the build context
.env
.env.*
!.env.example
devices.toml
data/
images/
snapshots/

# Environments, caches, tooling
.venv/
**/__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Repository and editor metadata
.git/
.github/
.idea/
.vscode/
.pre-commit-config.yaml

# Not part of the runtime image (the dashboard joins the image in Phase 4.4)
frontend/
tests/
docs/
Dockerfile
docker-compose.yml
ROADMAP.md
