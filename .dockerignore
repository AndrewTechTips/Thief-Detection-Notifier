# The image needs pyproject.toml, uv.lock, README.md, src/ and the frontend sources.

# Secrets and local state: never send them to the build context
.env
.env.*
!.env.example
devices.toml
data/
images/
snapshots/

# Environments, caches, tooling
.venv/
**/__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Repository and editor metadata
.git/
.github/
.idea/
.vscode/
.pre-commit-config.yaml

# The dashboard is built in its own stage from sources only
frontend/node_modules/
frontend/dist/
frontend/.e2e-data/
frontend/test-results/
frontend/playwright-report/

# Not part of the runtime image
tests/
docs/
Dockerfile
docker-compose.yml
ROADMAP.md
