{
  "name": "vision-hub-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build && node scripts/compress.mjs",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run api:check && npm test",
    "test": "vitest run",
    "api:schema": "cd .. && uv run --frozen vision-hub openapi --output frontend/openapi.json",
    "api:types": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "api:sync": "npm run api:schema && npm run api:types",
    "api:check": "openapi-typescript openapi.json --output src/api/schema.d.ts --check",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --config playwright.demo.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1"
  }
}
